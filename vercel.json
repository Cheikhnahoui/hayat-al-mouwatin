{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{public/**,src/db/migrations/**,node_modules/@libsql/**,node_modules/libsql/**,node_modules/@neon-rs/**,node_modules/@img/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/cron", "schedule": "0 5 * * *" }]
}
