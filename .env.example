# Copy to .env and edit. NEVER commit .env
# development for local work; use production on the server (then APP_SECRET must be a real secret)
NODE_ENV=development
PORT=3000
# Public URL of the site (no trailing slash) - used for canonical URLs, sitemap, Open Graph
SITE_URL=http://localhost:3000
# Path of the SQLite database file
DATABASE_PATH=./data/hayat.db
# Where uploaded media is stored
UPLOAD_DIR=./data/uploads
# Production: long random string (>= 32 chars). Generate: openssl rand -hex 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Development: may stay empty (a temporary secret is generated on each start)
APP_SECRET=
# Set to 1 when running behind a reverse proxy (nginx, Caddy, Cloudflare...) so client IPs and HTTPS are detected
TRUST_PROXY=0
# Max upload sizes in MB
MAX_IMAGE_MB=8
MAX_VIDEO_MB=60

# ---------- Vercel / production database (Turso = hosted SQLite) ----------
# Leave empty locally to use the file at DATABASE_PATH. On Vercel set both:
#   DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ---------- Vercel Blob (uploaded images / media) ----------
# Created automatically when you add a Blob store to the Vercel project (Storage tab).
BLOB_READ_WRITE_TOKEN=
# Optional override of the public Blob URL, e.g. https://<storeid>.public.blob.vercel-storage.com
BLOB_PUBLIC_URL=

# ---------- Cron (scheduled publishing safety net on Vercel) ----------
# Any long random string; Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
