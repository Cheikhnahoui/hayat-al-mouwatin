# Copy to .env and edit. NEVER commit .env
NODE_ENV=production
PORT=3000
# Public URL of the site (no trailing slash) - used for canonical URLs, sitemap, Open Graph
SITE_URL=https://www.example.com
# Path of the SQLite database file
DATABASE_PATH=./data/hayat.db
# Where uploaded media is stored
UPLOAD_DIR=./data/uploads
# Long random string (>= 32 chars) used to hash IPs / sign tokens. Generate: openssl rand -hex 32
APP_SECRET=change-me-with-a-long-random-string
# Set to 1 when running behind a reverse proxy (nginx, Caddy, Cloudflare...) so client IPs and HTTPS are detected
TRUST_PROXY=1
# Max upload sizes in MB
MAX_IMAGE_MB=8
MAX_VIDEO_MB=60
