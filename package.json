{
  "name": "hayat-al-mouwatin",
  "version": "1.0.0",
  "description": "Hayat Al Mouwatin - bilingual (AR/FR) Mauritanian news platform with CMS",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
